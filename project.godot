; Engine configuration file.
config_version=5

[application]

config/name="City of Crime"
config/description="An original open-world crime sandbox."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Catalog="*res://scripts/core/catalog.gd"
Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8

[rendering]

anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
lights_and_shadows/directional_shadow/size=4096
textures/canvas_textures/default_texture_filter=1

[shader_globals]

night_factor={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
